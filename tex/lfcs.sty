\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lfcs}[2026/08/26 Shared paper configuration]

% This paper is compiled with LuaLaTeX.
\RequirePackage{fontspec}

% Mathematics: ordinary AMS facilities first; LuaLaTeX patches next;
% Unicode/OpenType mathematics last.
\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{lualatex-math}
\RequirePackage{unicode-math}

\unimathsetup{
  math-style = ISO,
  bold-style = ISO,
  nabla = upright,
  partial = upright
}

% Typography
\setmainfont{TeX Gyre Termes}[
  Ligatures = TeX
]

\setsansfont{TeX Gyre Heros}[
  Scale = MatchLowercase
]

\setmonofont{TeX Gyre Cursor}[
  Scale = MatchLowercase
]

\setmathfont{STIX Two Math}

\RequirePackage{microtype}

% Figures, tables, colour
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{tabularx}


% Bibliography
\RequirePackage[useprefix=true, style=apa, sortcites=false,
  sorting=nyt, uniquename=false, uniquelist=false, backend=biber,
  hyperref=true]{biblatex}
\addbibresource{bib/references.bib}

% Varia
\RequirePackage{csquotes}
\RequirePackage{enumitem}
\setenumerate{labelsep=1ex}
\setitemize{labelsep=1ex}
\setdescription{labelsep=1ex}

% Hyperlinks: load near the end

\RequirePackage[
  colorlinks=true,
  linkcolor=blue,
  citecolor=blue,
  urlcolor=blue
]{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}

% Colloboration (notes)
\RequirePackage[colorinlistoftodos,
prependcaption,
textsize=tiny,
backgroundcolor=orange!30,
textwidth=80pt]{todonotes}

% Linguistic examples
\RequirePackage{expex}

